%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172b45","primaryTextColor":"#f8fafc","primaryBorderColor":"#60a5fa","lineColor":"#facc15","secondaryColor":"#182235","tertiaryColor":"#202b3d","clusterBkg":"#111c2e","clusterBorder":"#64748b","edgeLabelBackground":"#263449","fontFamily":"Arial","fontSize":"14px"},"flowchart":{"curve":"linear","htmlLabels":true,"nodeSpacing":34,"rankSpacing":44}}}%%
flowchart LR
    subgraph INTERNET["INTERNET"]
        direction TB
        CLIENT["Utilisateur distant<br/>Twingate Client"]
        TWIN["Twingate Cloud<br/>Contrôle d'accès"]
    end

    subgraph SI["SI LOCAL — ON-PREMISES"]
        direction TB
        CONN["Twingate Connector"]
        FW["Stormshield"]
        CORE["Commutateur cœur"]

        subgraph ZONES["RÉSEAU INTERNE"]
            direction LR
            V10["VLAN 10<br/>Utilisateurs"]
            V30["VLAN 30<br/>Administration"]
            subgraph V20["VLAN 20 — SERVEURS"]
                direction TB
                AD["Active Directory / DNS"]
                FILES["Serveur de fichiers"]
                APP["Serveur métier"]
                MICRO["Pare-feux hôtes<br/>Microsegmentation"]
                AD ~~~ FILES
                FILES ~~~ APP
                MICRO -.-> AD
                MICRO -.-> FILES
                MICRO -.-> APP
            end
            V40["VLAN 40<br/>Gestion réseau"]
        end
    end

    CLIENT -.->|"Authentification / décision"| TWIN
    CLIENT ==>|"Accès ZTNA chiffré"| CONN
    CONN ==>|"Flux autorisés"| FW
    FW --> CORE
    CORE --- V10
    CORE --- V30
    CORE --- V20
    CORE --- V40

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff
    classDef micro fill:#7f1d1d,stroke:#fb7185,stroke-width:2px,color:#ffffff

    class CLIENT,V10,V30,V40 endpoint
    class TWIN control
    class CONN,FW,CORE network
    class AD,FILES,APP server
    class MICRO micro

    linkStyle 0 stroke:#c084fc,stroke-width:2px,stroke-dasharray:5 4,color:#f8fafc
    linkStyle 1 stroke:#22c55e,stroke-width:5px,color:#ffffff
    linkStyle 2 stroke:#22c55e,stroke-width:5px,color:#ffffff
    linkStyle 3 stroke:#facc15,stroke-width:2.5px,color:#f8fafc
