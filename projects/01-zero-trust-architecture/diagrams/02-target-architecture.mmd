%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172b45","primaryTextColor":"#f8fafc","primaryBorderColor":"#60a5fa","lineColor":"#facc15","secondaryColor":"#182235","tertiaryColor":"#202b3d","clusterBkg":"#111c2e","clusterBorder":"#64748b","edgeLabelBackground":"#263449","fontFamily":"Arial","fontSize":"14px"},"flowchart":{"curve":"linear","htmlLabels":true,"nodeSpacing":35,"rankSpacing":48}}}%%
flowchart TB
    subgraph EXTERNAL["ACCÈS EXTERNE"]
        direction LR
        REMOTE["Postes distants<br/>Twingate Client"]
        INTERNET(("Internet"))
        subgraph TWINGATE["INFRASTRUCTURE TWINGATE — CLOUD"]
            direction LR
            CTRL["Controller<br/>Authentification · autorisation"]
            RELAY["Relay<br/>si connexion directe impossible"]
        end
    end

    subgraph ONSITE["SI LOCAL — ON-PREMISES"]
        direction TB
        subgraph ACCESS["POSTES ET ADMINISTRATION"]
            direction LR
            USERS["VLAN 10<br/>Postes utilisateurs<br/>Twingate Client"]
            ADM["VLAN 30<br/>Postes d'administration<br/>Twingate Client"]
        end

        FW["Stormshield<br/>Filtrage Internet et inter-zones"]
        CORE["Commutateur cœur de réseau"]

        subgraph CONNECTOR_ZONE["ZONE CONNECTOR — EMPLACEMENT À DÉFINIR"]
            CONN["Twingate Connector"]
        end

        subgraph INTERNAL_ZONES["ZONES INTERNES"]
            direction LR
            subgraph VLAN20["VLAN 20 — SERVEURS"]
                direction TB
                AD["Active Directory / DNS<br/>Pare-feu hôte"]
                FILES["Serveur de fichiers<br/>Pare-feu hôte"]
                APP["Serveur métier<br/>Pare-feu hôte"]
                MICRO["Microsegmentation<br/>Filtrage local des flux entre serveurs"]
                AD ~~~ FILES
                FILES ~~~ APP
                AD ~~~ APP
                MICRO -.-> AD
                MICRO -.-> FILES
                MICRO -.-> APP
            end

            subgraph VLAN40["VLAN 40 — GESTION DES ÉQUIPEMENTS"]
                MGMT["Interfaces d'administration<br/>Pare-feu · commutateurs · équipements"]
            end
        end
    end

    REMOTE -->|"Accès Internet"| INTERNET
    USERS -->|"Accès Internet"| FW
    ADM -->|"Accès Internet"| FW
    INTERNET <-->|"Échanges de contrôle"| CTRL
    CTRL -.->|"Informations d'autorisation"| REMOTE
    CTRL -.->|"Enregistrement et autorisation"| CONN
    CONN <-->|"Tunnel chiffré Client–Connector<br/>direct ou via Relay"| RELAY
    REMOTE <-->|"Tunnel chiffré Client–Connector<br/>direct si possible"| CONN

    FW <-->|"Accès Internet sortant du SI"| INTERNET
    FW <-->|"Routage et filtrage inter-zones"| CORE
    CORE --- USERS
    CORE --- ADM
    CORE --- CONN
    CORE --- VLAN20
    CORE --- MGMT

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff
    classDef micro fill:#7f1d1d,stroke:#fb7185,stroke-width:2px,color:#ffffff

    class REMOTE,USERS,ADM endpoint
    class CTRL,RELAY control
    class FW,CORE,CONN network
    class AD,FILES,APP,MGMT server
    class MICRO micro
    linkStyle default stroke:#facc15,stroke-width:2.5px,color:#f8fafc
