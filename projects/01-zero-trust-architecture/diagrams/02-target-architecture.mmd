flowchart LR
    USER["Poste distant<br/>Twingate Client"]

    subgraph INTERNET["INTERNET — INFRASTRUCTURE TWINGATE"]
        CONTROL["Controller<br/>Authentification et autorisation"]
        RELAY["Relay Twingate<br/>Facilite l'établissement du tunnel"]
    end

    FW["Pare-feu réseau<br/>Stormshield"]

    subgraph LOCAL["RÉSEAU LOCAL — DERRIÈRE LE STORMSHIELD"]
        CONNECTOR["Twingate Connector<br/>Zone dédiée"]
        subgraph VLAN20["VLAN 20 — SERVEURS"]
            direction TB
            AD["Active Directory / DNS<br/>Pare-feu hôte"]
            FILES["Serveur de fichiers<br/>Pare-feu hôte"]
            APP["Serveur métier<br/>Pare-feu hôte"]
            AD <-.->|"Flux autorisés uniquement"| FILES
            FILES <-.->|"Flux autorisés uniquement"| APP
            AD <-.->|"Flux autorisés uniquement"| APP
        end
    end

    USER <-->|"Authentification / autorisation"| CONTROL
    USER <-->|"Tunnel TLS chiffré<br/>P2P ou via Relay"| RELAY
    RELAY <-->|"Établissement du tunnel"| CONNECTOR

    CONNECTOR -->|"Connexions sortantes vers Twingate<br/>via le Stormshield"| FW
    FW --> RELAY

    CONNECTOR -->|"Accès aux ressources"| FW
    FW --> VLAN20

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff

    class USER endpoint
    class CONTROL,RELAY control
    class FW,CONNECTOR network
    class AD,FILES,APP server
    linkStyle default stroke:#facc15,stroke-width:3px,color:#f8fafc
