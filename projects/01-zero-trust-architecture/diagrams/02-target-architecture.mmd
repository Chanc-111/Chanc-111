%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172b45","primaryTextColor":"#f8fafc","primaryBorderColor":"#60a5fa","lineColor":"#facc15","secondaryColor":"#182235","tertiaryColor":"#202b3d","clusterBkg":"#111c2e","clusterBorder":"#64748b","edgeLabelBackground":"#263449","fontFamily":"Arial","fontSize":"14px"},"flowchart":{"curve":"linear","htmlLabels":true,"nodeSpacing":32,"rankSpacing":42}}}%%
flowchart LR
    subgraph INTERNET["INTERNET"]
        direction TB
        REMOTE["Utilisateurs distants<br/>Twingate Client"]
        TWIN["Twingate Cloud<br/>Plan de contrôle · Relay"]
    end

    subgraph SI["SI LOCAL — ON-PREMISES"]
        direction TB
        FW["Pare-feu Stormshield"]
        CORE["Commutateur cœur de réseau"]

        subgraph ZONES["SEGMENTATION RÉSEAU"]
            direction LR
            V10["VLAN 10<br/>Postes utilisateurs"]
            V30["VLAN 30<br/>Administration"]
            subgraph V20["VLAN 20 — SERVEURS"]
                direction TB
                AD["Active Directory / DNS"]
                FILES["Serveur de fichiers"]
                APP["Serveur métier"]
                MICRO["Pare-feux hôtes<br/>Microsegmentation"]
                AD ~~~ FILES
                FILES ~~~ APP
                MICRO -.-> AD
                MICRO -.-> FILES
                MICRO -.-> APP
            end
            V40["VLAN 40<br/>Gestion des équipements"]
        end

        CONN["Twingate Connector<br/>Zone locale dédiée"]
    end

    REMOTE --- TWIN
    TWIN --- FW
    FW --- CORE
    CORE --- V10
    CORE --- V30
    CORE --- V20
    CORE --- V40
    FW --- CONN
    CONN --- FW

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff
    classDef micro fill:#7f1d1d,stroke:#fb7185,stroke-width:2px,color:#ffffff

    class REMOTE,V10,V30,V40 endpoint
    class TWIN control
    class FW,CORE,CONN network
    class AD,FILES,APP server
    class MICRO micro
    linkStyle default stroke:#facc15,stroke-width:2.5px,color:#f8fafc
