flowchart LR
    USER["Utilisateurs et administrateurs<br/>Twingate Client"]

    subgraph TWIN["ACCÈS ZTNA — TWINGATE"]
        CONTROL["Plan de contrôle<br/>Authentification · autorisations"]
        CONNECTOR["Twingate Connector"]
    end

    subgraph SI["SI LOCAL"]
        FW["Pare-feu réseau<br/>Stormshield"]
        subgraph VLAN20["VLAN 20 — SERVEURS"]
            direction TB
            AD["Active Directory / DNS"]
            FILES["Serveur de fichiers"]
            APP["Serveur métier"]
            AD <-->|"Flux strictement nécessaires"| FILES
            FILES <-->|"Flux strictement nécessaires"| APP
            AD <-->|"Flux strictement nécessaires"| APP
        end
    end

    USER <-->|"Authentification et décision d'accès"| CONTROL
    USER ==>|"Accès aux ressources autorisées"| CONNECTOR
    CONNECTOR ==> FW
    FW ==> AD
    FW ==> FILES
    FW ==> APP

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff
    classDef micro fill:#7f1d1d,stroke:#fb7185,stroke-width:2px,color:#ffffff

    class USER endpoint
    class CONTROL,CONNECTOR control
    class FW network
    class AD,FILES,APP server
    linkStyle default stroke:#facc15,stroke-width:3px,color:#f8fafc
