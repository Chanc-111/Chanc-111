%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172b45","primaryTextColor":"#f8fafc","primaryBorderColor":"#60a5fa","lineColor":"#facc15","secondaryColor":"#182235","tertiaryColor":"#202b3d","clusterBkg":"#111c2e","clusterBorder":"#64748b","edgeLabelBackground":"#263449","fontFamily":"Arial","fontSize":"15px"},"flowchart":{"curve":"linear","htmlLabels":true,"nodeSpacing":55,"rankSpacing":65}}}%%
flowchart LR
    subgraph ACCESS["ACCÈS UTILISATEUR"]
        direction TB
        CLIENT["Poste utilisateur<br/>Twingate Client"]
    end

    subgraph TWIN["TWINGATE — INTERNET"]
        direction TB
        CONTROL["Plan de contrôle<br/>Authentification · autorisation"]
        RELAY["Relay<br/>si le lien direct est impossible"]
        CONTROL --- RELAY
    end

    subgraph PERIMETER["PÉRIMÈTRE DU SI"]
        direction TB
        FW["Stormshield<br/>Filtrage des flux"]
    end

    subgraph CONNECTOR_ZONE["ZONE CONNECTOR — RÉSEAU LOCAL"]
        CONNECTOR["Twingate Connector<br/>VLAN dédié"]
    end

    subgraph SERVERS["VLAN 20 — SERVEURS"]
        direction TB
        AD["Active Directory / DNS"]
        FILES["Serveur de fichiers"]
        APP["Serveur métier"]
        AD <-.->|"Flux autorisés uniquement"| FILES
        FILES <-.->|"Flux autorisés uniquement"| APP
        AD <-.->|"Flux autorisés uniquement"| APP
    end

    CLIENT <-->|"Authentification et autorisation"| CONTROL
    CLIENT <-->|"Tunnel chiffré Twingate<br/>direct ou via Relay"| CONNECTOR

    CONNECTOR -->|"Connexion sortante chiffrée<br/>vers l'infrastructure Twingate"| FW
    FW <-->|"Internet"| CONTROL

    CONNECTOR -->|"Flux applicatifs autorisés"| FW
    FW -->|"Filtrage inter-zone"| SERVERS

    classDef endpoint fill:#16324f,stroke:#60a5fa,stroke-width:2px,color:#ffffff
    classDef control fill:#3b245f,stroke:#c084fc,stroke-width:2px,color:#ffffff
    classDef network fill:#713f12,stroke:#fbbf24,stroke-width:3px,color:#ffffff
    classDef server fill:#164e3b,stroke:#4ade80,stroke-width:2px,color:#ffffff

    class CLIENT endpoint
    class CONTROL,RELAY control
    class FW,CONNECTOR network
    class AD,FILES,APP server
    linkStyle default stroke:#facc15,stroke-width:3px,color:#f8fafc
